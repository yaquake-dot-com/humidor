    "Someone logged in to your Soulseek account elsewhere": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Algú ha iniciat sessió al teu compte de Soulseek en un altre lloc"
          }
        },
