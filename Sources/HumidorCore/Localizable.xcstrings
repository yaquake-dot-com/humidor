    "%@: External port %@ successfully forwarded to local IP address %@ port %@": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Port extern %2$@ redirigit amb èxit a l'adreça IP local %3$@ port %4$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Externí port %2$@ úspěšně přesměrován na místní IP adresu %3$@ port %4$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Externer Port %2$@ erfolgreich an lokale IP-Adresse %3$@ Port %4$@ weitergeleitet"
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Puerto externo %2$@ reenviado con éxito a la dirección IP local %3$@ puerto %4$@"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Puerto externo %2$@ reenviado con éxito a la dirección IP local %3$@ puerto %4$@"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Väline port %2$@ siirati edukalt kohaliku IP aadressi %3$@ porti %4$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Le port externe %2$@ a été transféré avec succès vers l'adresse IP locale %3$@ port %4$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ külső port sikeresen továbbítva a %3$@ helyi IP-címre %4$@ helyi port"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Porta esterna %2$@ inoltrata con successo all'indirizzo IP locale %3$@ porta %4$@"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Ārējais ports %2$@ veiksmīgi pārsūtīts uz lokālo IP adresi %3$@ ar portu %4$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Externe poort %2$@ succesvol doorgestuurd naar lokaal IP-adres %3$@ poort %4$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Zewnętrzny port %2$@ pomyślnie przekierowany na lokalny adres IP %3$@ port %4$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Porta externa %2$@ encaminhada com sucesso para o endereço IP local %3$@ porta %4$@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Porta externa %2$@ encaminhada com sucesso para o endereço IP local %3$@ porta %4$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: внешний порт %2$@ успешно переброшен на локальный IP-адрес %3$@ порт %4$@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: வெளிப்புற துறைமுகம் %2$@ s உள்ளூர் இநெ முகவரி %3$@ துறைமுகத்திற்கு %4$@ வெற்றிகரமாக அனுப்பப்படுகின்றன"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ dış bağlantı noktası, %3$@ yerel IP adresi %4$@ bağlantı noktasına başarıyla iletildi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: зовнішній порт %@ успішно перенаправлено на локальну IP-адресу %@, порт %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：外部端口 %2$@ 成功转发到本地 IP 地址%3$@ %4$@ 端口"
          }
        }
      }
    },
    "%@: Failed to forward external port %@: %@": {
      "localizations": {
        "ca": {
          "stringUnit": {
