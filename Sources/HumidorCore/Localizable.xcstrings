    "You have no Soulseek privileges. While privileges are active, your downloads will be queued ahead of those of non-privileged users.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No tens privilegis de Soulseek. Mentre els privilegis estiguin actius, les descàrregues es posaran a la cua abans que les dels usuaris sense privilegis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemáte žádná privilegia Soulseek. Když jsou privilegia aktivní, vaše stahování bude umístěno ve frontě před uživateli, kteří nemají privilegia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast keine Soulseek Privilegien. Solange Privilegien aktiv sind, werden deine Downloads vor denen von nicht-privilegierten Nutzern in die Warteschlange eingereiht."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes privilegios en Soulseek. Mientras los privilegios estén activos, tus descargas se pondrán en cola antes que las de los usuarios sin privilegios."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes privilegios en Soulseek. Mientras los privilegios estén activos, tus descargas se pondrán en cola antes que las de los usuarios sin privilegios."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul pole Soulseeki privileege. Kui privileegid on aktiivsed, asetatakse sinu allalaadimised privileegideta kasutajate omadest järjekorras ette."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez pas de privilèges Soulseek. Lorsque les privilèges sont activés, vos téléchargements seront mis en file d'attente avant ceux des utilisateurs non privilégiés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincsenek Soulseek kiváltságai. Amíg a kiváltságok aktívak, a letöltései a nem kiváltságos felhasználók előtt kerülnek sorra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai privilegi Soulseek. Quando i privilegi sono attivi, i tuoi download saranno messi in coda davanti a quelli degli utenti senza privilegi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jums nav Soulseek privilēģiju. Kamēr privilēģijas ir aktīvas, jūsu lejupielādes tiks rindotas pirms nepriviliģēto lietotāju lejupielādēm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt geen Soulseek-privileges. Zolang privileges actief zijn, worden je downloads voorrang gegeven boven die van niet-geprivilegieerde gebruikers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz już przywilejów Soulseek. Gdy są one aktywne, pliki do pobrania będą umieszczane w kolejce przed plikami użytkowników nieuprzywilejowanych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não tem privilégios de Soulseek. Enquanto os privilégios estiverem ativos, seus downloads serão colocados na fila antes dos de usuários sem privilégios."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não tem privilégios Soulseek. Enquanto os privilégios estiverem ativos, seus downloads serão enfileirados à frente dos usuários sem privilégios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас нет привилегий. Привилегии не обязательны, но они позволяют вам скачивать файлы быстрее, в отличие от непривилегированных пользователей."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்கு ஆன்மாதேடு சலுகைகள் இல்லை. சலுகைகள் செயலில் இருக்கும்போது, உங்கள் பதிவிறக்கங்கள் சலுகை பெறாத பயனர்களைவிட வரிசையில் நிற்கப்படும்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulseek ayrıcalığınız yok. Ayrıcalıklar etkinken, indirmeleriniz ayrıcalıklı olmayan kullanıcılarınkinden önce sıraya alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас немає привілеїв Soulseek. Поки привілеї активні, ваші завантаження стають у черзі перед завантаженнями користувачів без привілеїв."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您没有 Soulseek 特权。特权用户的下载请求将优先于无特权用户。"
          }
        }
      }
    },
    "You need to specify a username and password before connecting…": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has d'especificar un nom d'usuari i una contrasenya abans de connectar-te…"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před připojením musíte zadat uživatelské jméno a heslo…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst einen Benutzernamen und ein Passwort angeben, bevor du dich verbindest…"
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Es necesario especificar un nombre de usuario y una contraseña antes de conectarse…"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes especificar un nombre de usuario y una contraseña antes de conectarte…"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Enne ühenduse loomist tuleb määrata kasutajanimi ja parool…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez spécifier un nom d'utilisateur et un mot de passe avant de vous connecter…"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csatlakozás előtt meg kell adni egy felhasználónevet és jelszót…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi specificare un nome utente ed una password prima di connetterti…"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirms savienojuma izveides ir jānorāda lietotājvārds un parole…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet een gebruikersnaam en wachtwoord opgeven voordat je verbindt…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Musisz podać nazwę użytkownika i hasło przed połączeniem…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você precisa especificar um nome de usuário e senha antes de se conectar…"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa especificar um nome de utilizador e palavra-passe antes de se conectar…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед подключением необходимо указать имя пользователя и пароль…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைப்பதற்கு முன் பயனர்பெயர் மற்றும் கடவுச்சொல்லை நீங்கள் குறிப்பிட வேண்டும்…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlanmadan önce bir kullanıcı adı ve parola belirtmeniz gerekir…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам потрібно вказати ім’я користувача та пароль перед підключенням…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在连接之前，您需要指定一个用户名和密码……"
          }
        }
      }
    },
