          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Nie udało się przekierować portu zewnętrznego %2$@: %3$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Falha ao encaminhar a porta externa %2$@: %3$@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Falha ao encaminhar a porta externa %2$@: %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: не удалось пробросить внешний порт %2$@: %3$@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: வெளிப்புற துறைமுகம் %2$@: %3$@ அனுப்புவதில் தோல்வி"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ dış bağlantı noktası iletilemedi: %3$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: не вдалося перенаправити зовнішній порт %@: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：转发外部端口 %2$@ 失败：%3$@"
          }
        }
      }
    },
