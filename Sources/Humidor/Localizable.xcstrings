            "state": "translated",
            "value": "Introduzca un término de búsqueda para buscar archivos compartidos por otros usuarios en la red Soulseek"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisesta otsisõna teiste Soulseeki võrgu kasutajate jagatud failide otsimiseks"
          }
