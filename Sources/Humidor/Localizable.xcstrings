    "By default, files longer than or equal to (>=) the entered duration will be matched, unless an operator (=, !, <=, < or >) is used.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per defecte, es trobaran els fitxers amb una durada igual o superior (>=) a la durada introduïda, llevat que s'utilitzi un operador (=, !, <=, < o >)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve výchozím stavu jsou zobrazeny soubory delší nebo odpovídající zadané délce (>=), pokud není použit operátor (=, !, <=, < nebo >)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig werden Dateien, die länger oder gleich (>=) der eingegebenen Dauer sind, abgeglichen, es sei denn, ein Operator (=, !, <=, < oder >) wird verwendet."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto, se buscarán los archivos cuya duración sea mayor o igual (>=) a la introducida, a menos que se utilice un operador (=, !, <=, < o >)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaikimisi loetakse vasteteks failid, mis on pikemad või sellega võrdsed (>=), välja arvatud juhul, kui kasutatakse operaatorit (=, !, < või >)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, les fichiers dont la durée est supérieure ou égale (>=) à la durée saisie seront pris en compte, sauf si un opérateur (=, !, <=, < ou >) est utilisé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alapértelmezés szerint a megadott időtartamnál hosszabb vagy azzal egyenlő fájlok (>=) illeszkednek, kivéve ha operátort (=, !, <=, < vagy >) használ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per impostazione predefinita, verranno selezionati i file più lunghi o con durata uguale (>=) a quella immessa, a meno che non venga utilizzato un operatore (=, !, <=, < o >)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pēc noklusējuma tiks atlasīti faili, kas ir garāki vai vienādi (>=) ar ievadīto ilgumu, ja vien nav izmantots kāds operators (=, !, <=, < vai >)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard worden bestanden die groter of gelijk zijn aan de ingevoerde duur vergeleken, tenzij een operator (=, !, < of >) wordt gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie dopasowywane będą pliki dłuższe lub równe (>=) wprowadzonemu czasowi trwania, chyba że użyty zostanie operator (=, !, <=, < lub >)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, arquivos maiores ou iguais a (>=) a duração inserida serão correspondidos, a menos que um operador (=, !, <=, < ou>)seja usado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, ficheiros maiores ou iguais a (>=) a duração inserida serão correspondidos, a menos que um operador (=, !, <=, < ou>)seja usado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию будут сопоставлены файлы, длина которых больше или равна (>=) введенной длительности, если не используется оператор (=, !, <=, < или >)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயல்பாக, ஒரு ஆபரேட்டர் (=,!, <=, <அல்லது>) பயன்படுத்தப்படாவிட்டால், உள்ளிட்ட காலத்தை விட நீளமாகவோ அல்லது சமமாகவோ இருக்கும் கோப்புகள் பொருந்தும்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öntanımlı olarak, bir operatör (=, !, < veya >) kullanılmadığı sürece, girilen süreye eşit veya daha uzun (>=) dosyalar eşleştirilecektir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若不使用运算符（=、!、< and >，）默认匹配大于或等于指定持续时间的文件。"
          }
        }
      }
    },
    "By default, the unit used is bytes (B) and files greater than or equal to (>=) the value will be matched.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per defecte, la unitat utilitzada és bytes (B) i es trobaran els fitxers iguals o superiors a (>=) el valor indicat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve výchozím stavu je použita jednotka bajty (B) a soubory větší nebo rovny (>=) dané hodnotě, budou nalezeny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig wird die Einheit Byte (B) verwendet und Dateien, die größer oder gleich (>=) dem Wert sind, werden gefunden."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto, la unidad utilizada es bytes (B) y los archivos mayores o iguales a (>=) el valor serán coincidentes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaikimisi kasutatakse ühikuks baite (B) ja väärtusest suuremad või sellega võrdsed (>=) failid loetakse vasteteks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, l'unité utilisée est l'octet (B) et les fichiers supérieurs ou égaux (>=) à cette valeur seront pris en compte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alapértelmezés szerint használt mértékegység a bájt (B), és az értéknél nagyobb vagy azzal egyenlő (>=) méretű fájlok illeszkednek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per impostazione predefinita, l'unità utilizzata è il byte (B) e i file con dimensione maggiore o uguale del (>=) valore verranno mostrati."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pēc noklusējuma izmantotā vienība ir baiti (B), un tiks saskaņoti faili, kas ir lielāki vai vienādi ar (>=) šo vērtību."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard is de gebruikte eenheid bytes (B) en bestanden groter dan of gelijk aan (>=) de waarde zullen overeenkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie używaną jednostką jest bajt (B), a pliki większe lub równe (>=) tej wartości będą dopasowywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, a unidade utilizada é bytes (B) e arquivos maiores ou iguais a (=) o valor será correspondido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, a unidade utilizada é bytes (B) e ficheiros maiores ou iguais a (=) o valor será correspondido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию используются единица измерения — байт (Б), и файлы, которые больше или равны (>=) сопоставимому значению."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயல்பாக, பயன்படுத்தப்படும் அலகு பைட்டுகள் (பி) மற்றும் (> =) ஐ விட அதிகமாக அல்லது சமமான கோப்புகள் மதிப்பு பொருந்தும்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öntanımlı olarak, kullanılan birim bayttır (B) ve değere eşit veya daha büyük (>=) dosyalar eşleşecektir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认情况下，使用的单位是字节(B)，将匹配大于或等于该值的文件。"
          }
        }
      }
    },
