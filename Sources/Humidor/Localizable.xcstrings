    "Soulseek is an unencrypted protocol not intended for secure communication.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulseek és un protocol sense xifrar que no està pensat per a una comunicació segura."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulseek je nešifrovaným protokolem, který není navržen pro bezpečnou komunikaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulseek ist ein unverschlüsseltes Protokoll, das nicht für sichere Kommunikation gedacht ist."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulseek es un protocolo no cifrado que no está pensado para la comunicación segura."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulseek on krüptimata protokoll, mis ei ole mõeldud turvaliseks suhtluseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulseek est un protocole non encrypté et n'est en aucun prévu à une communication sécurisée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Soulseek titkosítatlan protokoll, amelyet nem biztonságos kommunikációra találtak ki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulseek è un protocollo non crittografato non destinato alla comunicazione sicura."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulseek ir nešifrēts protokols, kas nav paredzēts drošai saziņai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulseek is een ongecodeerd protocol dat niet bedoeld is voor veilige communicatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulseek to niezaszyfrowany protokół nieprzeznaczony do bezpiecznej komunikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulseek é um protocolo não criptografado, não destinado à comunicação segura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulseek é um protocolo não criptografado, não destinado à comunicação segura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulseek - это незашифрованный протокол, не предназначенный для безопасного общения."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆன்மாதேடு என்பது பாதுகாப்பான தகவல்தொடர்புக்காக அல்ல மறைகுறியாக்கப்பட்ட நெறிமுறை."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulseek güvenli iletişim için tasarlanmamış şifreli olmayan bir protokoldür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulseek 是非加密协议，并非为加密通信设计。"
          }
        }
      }
    },
