        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பங்குகளைத் தயாரித்தல்"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşımlar Hazırlanıyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备共享"
          }
        }
      }
    },
    "Prepend ! to a value to exclude files of a specific size:\n    !30.5m to hide files that are 30.5 MiB (mebibytes).": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix ! davant d'un valor per excloure arxius d'una mida específica:\n    !30.5m per ocultar arxius que són 30.5 MiB (mebibytes)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro vyloučení souborů určité velikosti, přidejte před hodnotu znak \"!\":\n    !30.5m pro skrytí souborů o velikosti 30.5 MiB (mebibajtů)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein ! vor einen Wert, um Dateien einer bestimmten Größe auszuschließen:\n    !30.5m, um Dateien auszublenden, die 30,5 MiB (Mebibyte) groß sind."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteponga ! a un valor para excluir archivos de un tamaño específico:\n    !30.5m para ocultar archivos cuyo tamaño es 30,5 MiB (mebibytes)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa ! väärtusele, et välistada kindla suurusega failid:\n    !30,5m 30,5 MiB (mebibaiti) failide peitmiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez ! à une valeur pour spécifier une correspondance exacte :\n  !30.5m ne correspond qu'aux fichiers d'une taille de 30.5 Mio (mébi-octet)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„!” előtag az adott méretű fájlok kizárásához:\n    !30,5 m a 30,5 MiB (mebibájt) méretű fájlok elrejtéséhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteponi ! ad un valore per escludere i file di una dimensione specifica:\n    !30.5m per nascondere i file che pesano 30.5 MiB (mebibytes)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievienojiet sākumā ! vērtībai, lai neiekļautu konkrēta izmēra failus:\n    !30.5m, lai paslēptu failus, kuru izmērs ir 30.5 MiB (megabaiti)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg ! toe aan een waarde om bestanden van een specifieke grootte uit te sluiten:\n    !30.5m om bestanden die 30.5 MiB (mebibytes) zijn te verbergen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przedrostek ! do wartości, aby wykluczyć pliki o określonym rozmiarze:\n    !30,5m, aby ukryć pliki, które mają 30,5 MiB (mebibajtów)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-anexar! para um valor para excluir arquivos de um tamanho específico:\n!30,5m para ocultar arquivos com 30,5 MiB (mebibytes)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-anexar! para um valor para excluir ficheiros de um tamanho específico:\n!30,5m para ocultar ficheiros com 30,5 MiB (mebibytes)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте ! к значению, чтобы исключить файлы определенного размера:\n    !30.5m для скрытия файлов размером 30.5 MiB (Мебибайт)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தயார்! ஒரு குறிப்பிட்ட அளவிலான கோப்புகளை விலக்க ஒரு மதிப்புக்கு:\n 30.5 MIB (Mebibytes) கோப்புகளை மறைக்க 30.5 மீ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirli bir boyuttaki dosyaları hariç tutmak için bir değerin başına ! ekleyin: \n    !30.5m, boyutu 30.5 MiB (mebibayt) olan dosyaları hariç tutacaktır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前置!到一个值以排除特定大小的文件：\n    !30.5m 用于隐藏 30.5 MiB（兆字节）的文件。"
          }
        }
      }
    },
    "Prepend < or > to find files smaller/larger than the given value. Use a space between each condition to include a range:\n    >10.5m <1g to show files larger than 10.5 MiB, but smaller than 1 GiB.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteposa < o > per trobar fitxers més petits/grans que el valor donat. Utilitza un espai entre cada condició per incloure un rang:\n    >10.5m <1g per mostrar fitxers més grans de 10.5 MiB, però més petits de 1 GiB."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro nalezení souborů, které jsou větší/menší než zadaná hodnota, přidejte < nebo > před hodnotu. Použijte mezeru mezi každou podmínkou pro zahrnutí rozsahu:\n    >10.5m <1g pro zobrazení souborů větších než 10.5 MiB a menších než 1 GiB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge < oder > vor den Wert ein, um Dateien zu finden, die kleiner/größer als der angegebene Wert sind. Benutze ein Leerzeichen zwischen jeder Bedingung, um einen Bereich einzuschließen:\n    >10.5m <1g um Dateien anzuzeigen, die größer als 10,5 MiB, aber kleiner als 1 GiB sind."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Antepon < o > para buscar los archivos menores/mayores que el valor dado. Utiliza un espacio entre cada condición para incluir un rango:\n    >10.5m <1g para mostrar archivos mayores de 10.5 MiB, pero menores de 1 GiB."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa < või >, et leida antud väärtusest väiksemaid/suuremaid faile. Ulatuse lisamiseks kasuta iga tingimuse vahel tühikut:\n     >10,5m <1g, et kuvada faile, mis on suuremad kui 10,5 MiB, kuid väiksemad kui 1 GiB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez < ou > pour rechercher des fichiers plus petits/plus grands que la valeur donnée. Ajoutez un espace entre chaque conditions pour inclure une rangée de valeurs. :\n    >10,5m <1g pour afficher les fichiers de plus de 10,5 Mio, mais inférieur à 1 Gio."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megadott értéknél kisebb/nagyobb fájlok kereséséhez tegye a „<” vagy a „>” karaktert az érték elé. Használjon szóközt az egyes feltételek között egy tartomány megadásához:\n    >10,5 m <1g a nagyobb mint 10,5 MiB (mebibájt), de kisebb mint 1 GiB (gibibájt) méretű fájlok megjelenítéséhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteponi < o > per trovare file di dimensioni minori/maggiori del valore dato. Usa uno spazio tra ogni condizione per includere un intervallo:\n    >10.5m <1g per mostrare file più grandi di 10.5 MiB, ma più piccoli di 1 GiB."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievienojiet sākumā < vai >, lai atrastu failus, kas ir mazāki/lielāki par norādīto vērtību. Lai iekļautu diapazonu, starp katru nosacījumu izmantojiet atstarpi:\n    >10.5m <1g, lai parādītu failus, kas lielāki par 10.5 MiB, bet mazāki par 1 GiB."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg < of > toe om bestanden te vinden die kleiner/groter zijn dan de gegeven waarde. Gebruik een spatie tussen elke voorwaarde om een bereik op te nemen:\n    >10.5m <1g om bestanden weer te geven die groter zijn dan 10,5 MiB, maar kleiner dan 1 GiB."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprzedź < lub >, aby znaleźć pliki mniejsze/większe od podanej wartości. Użyj spacji pomiędzy każdym warunkiem, aby zawrzeć zakres:\n    >10,5m <1g, aby pokazać pliki większe niż 10,5 MiB, ale mniejsze niż 1 GiB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe ou para localizar arquivos menores/maiores que o valor fornecido. Use um espaço entre cada condição para incluir um intervalo:\n    >10,5m<1g para mostrar arquivos maiores que 10,5 MiB, mas menores que 1 GiB."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe ou para localizar ficheiros menores/maiores que o valor fornecido. Use um espaço entre cada condição para incluir um intervalo:\n    >10,5m<1g para mostrar ficheiros maiores que 10,5 MiB, mas menores que 1 GiB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте символ меньше (<) или больше (>), чтобы найти файлы меньше или больше заданного значения:\n>10.5m <1g для отображения файлов размером более 10.5 МиБ (мебибайт), но меньше 1 ГиБ (гибибайт)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கொடுக்கப்பட்ட மதிப்பை விட சிறிய/பெரிய கோப்புகளைக் கண்டுபிடிக்க <அல்லது> ஆயத்தம் செய்யுங்கள். வரம்பைச் சேர்க்க ஒவ்வொரு நிபந்தனைக்கும் இடையில் ஒரு இடத்தைப் பயன்படுத்தவும்:\n > 10.5 மீ <1 ஐயா 10.5 எம்ஐபியை விட பெரிய கோப்புகளைக் காட்ட, ஆனால் 1 கிப் விட சிறியது."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilen değerden daha küçük/büyük dosyaları bulmak için < veya > ekleyin. Bir aralık eklemek için her koşul arasında bir boşluk kullanın:\n    >10.5m <1g, 10,5 MiB'den büyük ancak 1 GiB'den küçük dosyaları gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте < або > перед значенням, щоб знайти файли менші/більші за вказане значення. Використовуйте пробіл між умовами, щоб включити діапазон:\n    >10.5m <1g щоб показати файли більші за 10.5 МіБ, але менші за 1 ГіБ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前缀 < or > 查找小于或大于给定值的文件：在匹配条件中间插入空格来表示范围：\n    >10.5m <1g 显示大于 10.5 MiB、小于 1 GiB 的文件。"
          }
        }
      }
    },
    "Prepend = to a value to specify an exact match:\n    =1024 matches files that are exactly 1 KiB (kibibyte).": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteposa = a un valor per especificar una coincidència exacta:\n    =1024 coincideix amb arxius que tenen exactament 1 KiB (kibibyte)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro stanovení přesné shody, přidejte před hodnotu znak \"=\":\n    =1024 odpovídá souborům o velikosti 1 KiB (kibibajt)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "=1024 vor einem Wert setzen, um eine exakte Übereinstimmung anzugeben:\n    =1024 findet Dateien, die genau 1 KiB (Kibibyte) groß sind."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Antepon = a un valor para especificar una coincidencia exacta:\n    =1024 coincide con archivos que tengan exactamente 1 KiB (kibibyte)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa = väärtusele, et määrata täpne vaste:\n    =1024 vastab ainult failidele, mis on 1 KiB (kibibait)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez = à une valeur pour spécifier une correspondance exacte :\n    =1024 correspond à des fichiers d'exactement 1 KiB (kibioctet)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pontos egyezés megadásához az érték elé kell tenni az egyenlőségjelet (=):\n    =1024 csak az 1KiB (kibibájt) méretű fájlokra illeszkedik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteponi = ad un valore per specificare una corrispondenza esatta:\n    =1024 combacia con i file di dimensione di esattamente 1 KiB (kibibyte)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievienojiet sākumā = vērtībai, lai norādītu precīzu atbilstību:\n    =1024 atbilst failiem, kas ir tieši 1 KiB (kibibaits)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg = toe aan een waarde om een exacte overeenkomst te specificeren:\n    =1024 komt overeen met bestanden die precies 1 KiB (kibibyte) zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprzedź = do wartości, aby określić dokładne dopasowanie:\n    =1024 dopasowuje tylko pliki, które mają rozmiar 1 KiB (kibibajt)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe = a um valor para especificar uma correspondência exata:\n    =1024 corresponde a arquivos com exatamente 1 KiB (kibibyte)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe = a um valor para especificar uma correspondência exata:\n    =1024 corresponde a ficheiros com exatamente 1 KiB (kibibyte)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте знак рaвенства (=) к значению, чтобы указать точное соответствие:\n=1024 соответствует только файлам размером 1 КиБ (Кибибайт)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரியான பொருத்தத்தைக் குறிப்பிட ஒரு மதிப்புக்கு = ஆயத்தம் செய்யுங்கள்:\n = 1024 சரியாக 1 KIB (KIBIBYTE) கொண்ட கோப்புகளுடன் பொருந்துகிறது."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam bir eşleşme belirtmek için bir değerin başına = ekleyin:\n    =1024, yalnızca boyutu 1 KiB (kibibayt) olan dosyalarla eşleşir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前缀=指定精确匹配的值：\n    =1024 仅匹配大小为 1 KiB （即 1 kibibyte）的文件。"
          }
        }
      }
    },
