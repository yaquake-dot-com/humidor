    "Use | (or pipes) to seperate several exact phrases. Example:\n    Remix|Dub Mix|Instrumental": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitza | (o pipes) per separar diverses frases exactes. Exemple:\n    Remix|Dub Mix|Instrumental"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte | (roury/pipe) k oddělení několika přesných frází. Příklad:\n    Remix|Dub Mix|Instrumental"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende | (oder Pipes), um mehrere exakte Phrasen zu trennen. Beispiel:\n    Remix|Dub-Mix|Instrumental"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza | (o tubos) para separar varias frases exactas. Ejemplo:\n    Remix|Dub Mix|Instrumental"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasuta sümbolit |, et eraldada mitut täpset väljendit. Näide:\n    Remix|Dub Mix|Instrumental"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser | (ou tuyaux) pour séparer plusieurs phrases exactes. Exemple :\n    Remix|Dub Mix|Instrumental"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használja a „|” karaktert (cső), több pontos kifejezés elválasztására. Példa:\n    Remix|Dub Mix|Instrumental"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa | (o tubi) per separare varie frasi esatte. Esempio:\n    Remix|Dub Mix|Instrumental"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmantojiet | (vertikāla līnija), lai atdalītu vairākas precīzas frāzes. Piemērs:\n    Remix|Dub Mix|Instrumental"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik | (of pijp) om verschillende exacte zinnen van elkaar te scheiden. Voorbeeld:\n    Remix|Dubmix|Instrumentaal"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj | (lub potoków), aby oddzielić kilka dokładnych fraz. Przykład:\n    Remiksy|Dub Mix|Instrumentalne"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar | (ou tubos) para separar várias frases exatas. Exemplo:\n    Remix|Dub Mix|Instrumental"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar | (ou tubos) para separar várias frases exatas. Exemplo:\n    Remix|Dub Mix|Instrumental"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте символ |, для разделения нескольких точных фраз. Пример:\nRemix|Dub Mix|Instrumental"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயன்படுத்த | (குழாய்களின்) பல சரியான சொற்றொடர்களைப் பிரிக்க. எடுத்துக்காட்டு:\n    மறுகலப்பு | ஒலி கலப்பு| கருவி"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç tam ifadeyi ayırmak için | (veya boru karakteri) kullanın. Örnek:\n    Remix|Dub Mix|Instrumental"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 | （“或”管道符）来分隔短语。示例：\n    Remix|Dub Mix|伴奏"
          }
        }
      }
    },
    "User": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuari"
          }
        },
        "cs": {
