    "Only show results from users with an available upload slot.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra només els resultats dels usuaris amb un lloc de pujada disponible."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorazení pouze výsledků od uživatelů s dostupným slotem pro nahrávání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige nur Ergebnisse von Benutzern mit einem verfügbaren Upload-Slot."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar solo resultados de usuarios con algún puesto de subida disponible."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar solo resultados de usuarios con algún puesto de subida disponible."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva tulemused ainult nendelt kasutajatelt, kellel on vaba üleslaadimispesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher uniquement les résultats des utilisateurs ayant un créneau de téléchargement disponible."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az olyan felhasználók eredményeit jelenítse meg akiknek van szabad feltöltési szála."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra solo i risultati degli utenti con uno slot di upload disponibile."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rādīt tikai to lietotāju rezultātus, kuriem ir pieejams augšupielādes slots."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen resultaten van gebruikers met een beschikbare uploadslot weergeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuj tylko te rezultaty od użytkowników z wolnym slotem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar apenas resultados de usuários com um slot de upload disponível."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar apenas resultados de utilizadores com um slot de upload disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать результаты только от пользователей с доступным слотом для отдачи."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கிடைக்கக்கூடிய பதிவேற்ற ச்லாட் மூலம் பயனர்களிடமிருந்து முடிவுகளை மட்டுமே காண்பி."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kullanılabilir bir yükleme yuvasına sahip kullanıcılardan gelen sonuçları göster."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати результати лише від користувачів із доступним слотом для вивантаження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示具有可用上传槽位的用户的结果。"
          }
        }
      }
    },
