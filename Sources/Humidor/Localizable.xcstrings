    "Searches shorter than this number of characters will be ignored:": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cerques més curtes que aquest nombre de caràcters s'ignoraran:"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledávání kratší než tento počet znaků budou ignorována:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchanfragen mit weniger Zeichen als diese Zahl werden ignoriert:"
          }
        },
        "es-CL": {
