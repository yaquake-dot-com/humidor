    "Files you download from other users are queued here, and can be paused and resumed on demand": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els fitxers que descarreguis d'altres usuaris es posen en cua aquí i es poden posar en pausa i reprendre a petició"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory, které stáhnete od ostatních uživatelů, jsou zde zařazeny do fronty a lze je pozastavit nebo pokračovat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, die du von anderen Nutzern herunterlädst, werden hier in die Warteschlange gestellt und können nach Bedarf pausiert und fortgesetzt werden"
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos que descargue de otros usuarios se ponen en cola aquí, y se pueden pausar y reanudar cuando se desee"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos que descargues de otros usuarios se ponen en cola aquí, y se pueden pausar y reanudar cuando se desee"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teistelt kasutajatelt alla laaditud failid on siin järjekorras ning neid saab nõudmisel peatada ja jätkata"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers que vous téléchargez auprès d'autres utilisateurs sont mis en file d'attente ici, et peuvent être mis en pause et repris à la demande"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlok, amiket más felhasználóktól tölt le, itt vannak sorba állítva, és igény szerint szüneteltethetők és folytathatók"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file scaricati da altri utenti vengono accodati qui e possono essere messi in pausa e ripresi su richiesta"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili, kurus lejupielādējat no citiem lietotājiem, tiek ierindoti šeit, un tos var pauzēt un atsākt pēc pieprasījuma"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden die je van andere gebruikers downloadt, worden hier in de wachtrij gezet en kunnen naar wens worden gepauzeerd en hervat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki pobierane od innych użytkowników są tutaj umieszczane w kolejce i mogą być wstrzymywane i wznawiane na żądanie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos que você baixa de outros usuários são enfileirados aqui e podem ser pausados e retomados sob demanda"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros que descarrega de outros utilizadores são enfileirados aqui e podem ser pausados e retomados sob necessidade"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы, которые вы загружаете от других пользователей, помещаются здесь в очередь и их можно приостанавливать и возобновлять по запросу"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிற பயனர்களிடமிருந்து நீங்கள் பதிவிறக்கும் கோப்புகள் இங்கே வரிசையில் நிற்கின்றன, மேலும் இடைநிறுத்தப்பட்டு தேவைக்கேற்ப மீண்டும் தொடங்கலாம்"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer kullanıcılardan indirdiğiniz dosyalar burada kuyruğa alınır ve istendiğinde duraklatılıp devam ettirilebilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли, які ви завантажуєте від інших користувачів, знаходяться тут у черзі, і їх можна призупинити та відновити за запитом"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您从其他用户下载的文件在此处排队，按需暂停和恢复"
          }
        }
      }
    },
    "Files, folders and usernames containing this text will be shown.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es mostraran els fitxers, carpetes i noms d'usuari que contenen aquest text."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí se soubory, složky a uživatelská jména obsahující tento text."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, Ordner und Benutzernamen, die diesen Text enthalten, werden angezeigt."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mostrarán los archivos, carpetas y nombres de usuario que contienen este texto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvatakse seda teksti sisaldavad failid, kaustad ja kasutajanimed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers, dossiers et utilisateurs contenant ce texte seront affichés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megadott szöveget tartalmazó fájlok, mappák és felhasználónevek jelennek meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno visualizzati i file, le cartelle e i nomi utente contenenti questo testo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiks parādīti faili, mapes un lietotājvārdi, kas satur šo tekstu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden, mappen en gebruikersnamen die deze tekst bevatten, worden weergegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki, foldery i nazwy użytkowników zawierające ten tekst będą pokazane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos, pastas e nomes de usuários contendo este texto serão mostrados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficheiros, pastas e nomes de utilizadores contendo este texto serão mostrados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут показаны файлы, каталоги и пользователи, содержащие этот текст."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உரையைக் கொண்ட கோப்புகள், கோப்புறைகள் மற்றும் பயனர்பெயர்கள் காண்பிக்கப்படும்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu metni içeren dosyalar, klasörler ve kullanıcı adları gösterilecektir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示包含此文本的文件、文件夹和用户名。"
          }
        }
      }
    },
