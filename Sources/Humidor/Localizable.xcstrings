    "Join an existing chat room, or create a new room to chat with other users on the Soulseek network": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Uneix-te a una sala de xat existent o crea una sala nova per a xatejar amb altres usuaris de la xarxa Soulseek"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte se k existující chatovací místnosti nebo vytvořte novou místnost pro chatování s ostatními uživateli v síti Soulseek"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tritt einem bestehenden Chatraum bei oder erstelle einen neuen Raum, um mit anderen Nutzern im Soulseek-Netzwerk zu chatten"
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Únase a una sala de chat existente, o cree una nueva sala para chatear con otros usuarios de la red Soulseek"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Únete a una sala de chat existente, o crea una nueva sala para chatear con otros usuarios de la red Soulseek"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitu olemasoleva jututoaga või loo uus ruum, et vestelda teiste Soulseeki võrgu kasutajatega"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez un salon de discussion existant ou créez un nouveau salon pour discuter avec d'autres utilisateurs du réseau Soulseek"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakozzon egy meglévő csevegőszobához vagy hozzon létre egy új szobát, hogy cseveghessen a Soulseek hálózat többi felhasználójával"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisciti ad un canale esistente o creane uno nuovo per parlare con altri utenti sulla rete Soulseek"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievienojieties esošai tērzēšanas istabai vai izveidojiet jaunu istabu, lai tērzētu ar citiem lietotājiem Soulseek tīklā"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betreed een bestaande chatkamer, of maak een nieuwe kamer om te chatten met andere gebruikers op het Soulseek-netwerk"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołącz do istniejącego pokoju czatowego lub stwórz nowy pokój, aby rozmawiać z innymi użytkownikami sieci Soulseek"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Junte-se a uma sala de bate-papo existente ou crie uma nova sala para conversar com outros usuários na rede Soulseek"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Junte-se a uma sala de bate-papo existente ou crie uma nova sala para conversar com outros utilizadores na rede Soulseek"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Присоединяйтесь к существующим комнатам или создайте новую, чтобы общаться с другими пользователями в сети Soulseek"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்கனவே உள்ள அரட்டை அறையில் சேரவும் அல்லது ஆன்மாதேடு பிணைப்பில் மற்ற பயனர்களுடன் அரட்டையடிக்க ஒரு புதிய அறையை உருவாக்கவும்"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulseek ağındaki diğer kullanıcılarla sohbet etmek için mevcut bir sohbet odasına katılın veya yeni bir oda oluşturun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приєднайтеся до наявної кімнати чату або створіть нову кімнату для спілкування з іншими користувачами мережі Soulseek"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入现有的聊天室，或创建一个新的聊天室，与Soulseek网络上的其他用户聊天"
          }
        }
      }
    },
