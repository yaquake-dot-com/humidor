    "The better-known variants kb, mb, and gb can also be used for kilobyte, megabyte, and gigabyte units.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les variants més conegudes kb, mb i gb també es poden utilitzar per a unitats kilobyte, megabyte i gigabyte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Známější varianty kb, mb a gb mohou být také použity pro jednotky kilobajtů, megabajtů a gigabajtů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bekannteren Varianten kb, mb und gb können auch für Kilobyte, Megabyte und Gigabyte verwendet werden."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las variantes kb, mb y gb, más conocidas, también pueden utilizarse en lugar de las unidades de kilobyte, megabyte y gigabyte."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üldtuntud variante kb, mb ja gb saab kasutada ka kilobaitide, megabaitide ja gigabaitide jaoks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par commodité, les populaires variantes kb, mb et gb respectivement pour kilo-octet, méga-octet et giga-octet peuvent également être utilisées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jobban ismert változatok, a „kb”, „mb” és „gb” is használható a kilobájt, megabájt és gigabájt egységek megadására."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche le più note varianti kb, mb e gb possono essere utilizzate per le unità kilobyte, megabyte e gigabyte."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Labāk zināmos variantus kb, mb un gb var izmantot arī kilobaita, megabaita un gigabaita vienībām."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beter bekende varianten kb, mb en gb kunnen ook gebruikt worden voor kilobyte, megabyte en gigabyte eenheden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bardziej znane warianty kb, mb i gb mogą być również używane dla jednostek kilobajtowych, megabajtowych i gigabajtowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As variantes mais conhecidas kb, mb e gb também podem ser usadas para unidades de kilobyte, megabyte e gigabyte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As variantes mais conhecidas kb, mb e gb também podem ser usadas para unidades de kilobyte, megabyte e gigabyte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более известные варианты kb, mb и gb также могут использоваться для обозначения единиц измерения Килобайт, Мегабайт и Гигабайт."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கிலோபைட், மெகாபைட் மற்றும் சிகாபைட் அலகுகளுக்கும் நன்கு அறியப்பட்ட வகைகள் கேபி, எம்பி மற்றும் சிபி ஆகியவற்றைப் பயன்படுத்தலாம்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha iyi bilinen kb, mb ve gb çeşitleri kilobayt, megabayt ve gigabayt birimleri için de kullanılabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常见的kb、mb和gb也可以用于千字节、兆字节和千兆字节单位。"
          }
        }
      }
    },
