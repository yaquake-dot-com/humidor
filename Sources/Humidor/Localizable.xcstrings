    "Prohibit users from accessing your shared files, based on username, IP address or country.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prohibir als usuaris accedir als teus fitxers compartits, segons el nom d'usuari, l'adreça IP o el país."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakažte uživatelům přístup k vašim sdíleným souborům na základě uživatelského jména, IP adresy nebo země."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzer basierend auf Benutzername, IP-Adresse oder Land daran hindern, auf deine freigegebenen Dateien zuzugreifen."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Prohibir a los usuarios el acceso a los archivos que usted comparte, basándose en el nombre de usuario, la dirección IP o el país."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Prohibir a los usuarios el acceso a los archivos que compartas, basándose en el nombre de usuario, la dirección IP o el país."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Keela kasutajatel juurdepääs oma jagatud failidele kasutajanime, IP aadressi või riigi alusel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interdire aux utilisateurs d'accéder à vos fichiers partagés, en fonction du nom d'utilisateur, de l'adresse IP ou du pays."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Felhasználónév, IP-cím vagy ország alapján tiltja a felhasználóknak, az Ön által megosztott fájlok elérését."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proibisci agli utenti di accedere ai tuoi file condivisi, in base a nome utente, indirizzo IP o paese."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aizliegt lietotājiem piekļūt jūsu koplietotajiem failiem, pamatojoties uz lietotājvārdu, IP adresi vai valsti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikers verbieden toegang tot je gedeelde bestanden op basis van gebruikersnaam, IP-adres of land."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabroń użytkownikom dostępu do udostępnionych plików na podstawie nazwy użytkownika, adresu IP lub kraju."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proibir que os usuários acessem seus arquivos compartilhados, com base no nome de usuário, endereço IP ou país."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Proibir que os utilizadores acedem os seus ficheiros partilhados, com base no nome de utilizador, endereço IP ou país."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запретить пользователям доступ к вашим общим файлам на основе имени пользователя, IP-адреса или страны."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயனர்பெயர், ஐபி முகவரி அல்லது நாட்டின் அடிப்படையில் உங்கள் பகிரப்பட்ட கோப்புகளை அணுக பயனர்கள் தடைசெய்க."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı adı, IP adresi veya ülkeye göre kullanıcıların paylaşılan dosyalarınıza erişmesini yasaklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заборонити користувачам доступ до ваших спільних файлів на основі імені користувача, IP-адреси або країни."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据用户名、IP 地址或国家/地区，禁止用户访问您的共享文件。"
          }
        }
      }
    },
