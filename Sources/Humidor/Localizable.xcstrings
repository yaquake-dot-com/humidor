    "Verify that external disks are mounted and folder permissions are correct.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comproveu que els discs externs estiguin muntats i que els permisos de les carpetes siguin correctes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověřte, že jsou připojeny externí disky a že jsou správná oprávnění složky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfe, ob externe Festplatten eingebunden sind und die Ordnerberechtigungen korrekt sind."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica que los discos externos estén montados y que los permisos de las carpetas sean correctos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Veendu, et välised kettad on ühendatud ja kausta load on õiged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que les disques externes sont montés et que les permissions sur les dossiers sont correctes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizze, hogy a külső lemezek felcsatolása és a mappaengedélyek helyesek-e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che i dischi esterni siano montati e che i permessi delle cartelle siano corretti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārbaudiet, vai ārējie diski ir pievienoti un vai mapju atļaujas ir pareizas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer of externe schijven zijn aangesloten en of de maprechten correct zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy dyski zewnętrzne są zamontowane, a uprawnienia do folderów są prawidłowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se os discos externos estão montados e se as permissões das pastas estão corretas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se os discos externos estão montados e se as permissões das pastas estão corretas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что внешние диски смонтированы и доступ к папкам разрешён."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வெளிப்புற வட்டுகள் ஏற்றப்பட்டுள்ளனவா என்பதை சரிபார்க்கவும் மற்றும் கோப்புறை அனுமதிகள் சரியானவை."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harici disklerin başlandığını ve klasör izinlerinin doğru olduğunu doğrulayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证外部磁盘是否挂载、文件夹权限是否正确。"
          }
        }
      }
    },
