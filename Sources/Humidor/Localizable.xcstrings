    "Case is insensitive, but word order is important: 'Instrumental Remix' will not show any 'Remix Instrumental'": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No distingeix entre majúscules i minúscules, però l'ordre de les paraules és important: «Instrumental Remix» no mostrarà cap «Remix Instrumental»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Malá nebo velká písmena nehrají roli, je ale důležité pořadí slov: 'Instrumental Remix' nezobrazí 'Remix Instrumental'"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Groß- und Kleinschreibung ist unwichtig, aber die Wortreihenfolge ist wichtig: 'Instrumental Remix' wird keinen 'Remix Instrumental' anzeigen"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mayúsculas o minúsculas son indiferentes, pero el orden de las palabras es importante: 'Instrumental Remix' no mostrará ningún 'Remix Instrumental'"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähesuurus ei ole oluline, kuid sõnade järjekord on oluline: \"Instrumental Remix\" ei näita tulemusi \"Remix Instrumental\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche n'est pas sensible à la casse mais l'ordre des mots est important : « Instrumental Remix » n'affichera pas les résultats avec « Remix Instrumental »"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem kis- és nagybetű érzékeny, de a szórend fontos: az „Instrumental Remix” nem jeleníti meg a „Remix Instrumental” egyik elemét sem"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Maiuscole/minuscole sono ignorate, ma l'ordine delle parole rimane importante: 'Instrumental Remix' non mostrerà alcuna 'Remix Instrumental'"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lielo/mazo burtu lietojums ir nebūtisks, taču vārdu secība ir svarīga: 'Instrumental Remix” nerādīs nevienu 'Remix Instrumental'"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoofdlettergebruik is niet belangrijk, maar de volgorde van woorden wel: 'Instrumental Remix' zal geen 'Remix Instrumental' weergeven"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wielkość liter nie ma znaczenia, ale ważna jest kolejność słów: „Instrumental Remix” nie pokaże żadnego „Remix Instrumental”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Maiúsculas e minúsculas são insensíveis, mas a ordem das palavras é importante: 'Instrumental Remix' não mostrará nenhum 'Remix Instrumental'"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Maiúsculas e minúsculas são insensíveis, mas a ordem das palavras é importante: 'Instrumental Remix' não mostrará nenhum 'Remix Instrumental'"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистр нечувствителен, но порядок слов важен: 'Instrumental Remix' не покажет никаких 'Remix Instrumental'"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வழக்கு உணர்ச்சியற்றது, ஆனால் சொல் வரிசை முக்கியமானது: 'கருவி ரீமிக்ச்' எந்த 'ரீமிக்ச் கருவியை' காட்டாது"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük/küçük harfe duyarlı değildir, ancak sözcük sırası önemlidir: 'Instrumental Remix' herhangi bir 'Remix Instrumental' göstermeyecektir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不区分大小写，但词序很重要：“Instrumental Remix”不会显示任何“Remix Instrumental”的结果"
          }
        }
      }
    },
