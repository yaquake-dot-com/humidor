    "Now Playing allows you to display what your media player is playing by using the /now command in chat.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«Reproduint ara» et permet mostrar el que reprodueix el teu reproductor multimèdia mitjançant l'ordre /now al xat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkce Nyní se přehrává umožňuje zobrazit, co přehrávač médií právě přehrává, pomocí příkazu /now v chatu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt läuft, zeigt an, was dein Mediaplayer gerade spielt, indem du den Befehl /now im Chat verwendest."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduciendo Ahora le permite mostrar lo que su reproductor multimedia está reproduciendo utilizando el comando /now en el chat."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "«Reproduciendo ahora» te permite mostrar lo que tu reproductor multimedia está reproduciendo utilizando el comando /now en el chat."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "'Esitamisel' võimaldab kuvada meediamängijas esitatav lugu, kasutades vestluses käsku /now."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Now Playing vous permet d'afficher ce que votre lecteur mutimédia est en train de jouer grâce à la commande /now dans une discussion."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A /now paranccsal a csevegés közben megtekintheti, hogy éppen mit játszik le a médialejátszó."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta Ascoltando ti consente di visualizzare ciò che sta riproducendo il tuo lettore multimediale utilizzando il comando /now in chat."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "'Tagad atskaņo' ļauj parādīt, kas tiek atskaņots jūsu multivides atskaņotājā, tērzēšanā izmantojot komandu '/now'."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met 'Nu aan het afspelen' kun je laten zien wat je mediaspeler afspeelt door de commando /now in chat te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcja „Teraz odtwarzanie” pozwala na wyświetlanie odtwarzanego utworu w pokoju rozmów przy pomocy komendy /now."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduzindo Agora permite que você exiba o que seu reprodutor de mídia está tocando usando o comando /now no bate-papo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Reproduzir Agora permite que exiba o que o seu reprodutor de mídia está tocando usando o comando /now no bate-papo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сейчас играет» позволяет отображать то, что воспроизводит ваш медиаплеер, с помощью команды /now в чате."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது விளையாடுவது அரட்டையில் /இப்போது கட்டளையைப் பயன்படுத்தி உங்கள் மீடியா பிளேயர் விளையாடுவதைக் காட்ட உங்களை அனுமதிக்கிறது."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi Oynatılıyor, sohbette /now komutunu kullanarak ortam oynatıcınızın ne çaldığını görüntülemenizi sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Функція «Зараз відтворюється» дозволяє відображати, що відтворює ваш програвач, за допомогою команди /now у чаті."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许您在聊天中使用 /now 命令显示媒体播放器正在播放的内容。"
          }
        }
      }
    },
