    "User's list of shared files is empty. Either the user is not sharing anything, or they are sharing files privately.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La llista de fitxers compartits d'usuari està buida. O l'usuari no comparteix res o està compartint fitxers de manera privada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seznam sdílených souborů uživatele je prázdný. Uživatel buď nic nesdílí, nebo sdílí soubory soukromě."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste der freigegebenen Dateien des Benutzers ist leer. Entweder teilt der Benutzer nichts, oder er teilt Dateien privat."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de archivos compartidos del usuario está vacía. Bien porque el usuario no está compartiendo nada, o bien porque está compartiendo archivos de forma privada."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de archivos compartidos del usuario está vacía. Bien porque el usuario no está compartiendo nada, o bien porque está compartiendo archivos de forma privada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasutaja jagatud failide loend on tühi. Kasutaja ei jaga midagi või jagab faile privaatselt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des fichiers partagés par l'utilisateur est vide. L'utilisateur ne partage aucun contenu, ou alors ses partages sont privés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felhasználó által megosztott fájlok listája üres. A felhasználó nem oszt meg semmit, vagy a fájlokat privát módon osztja meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista dei file condivisi dall'utente vuota. O l'utente non condivide nulla o condivide file in privato."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietotāja koplietoto failu saraksts ir tukšs. Vai nu lietotājs neko nekopīgo, vai arī kopīgo failus privāti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lijst met gedeelde bestanden van de gebruiker is leeg. Of de gebruiker deelt niets, of ze delen bestanden privé."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista zasobów użytkownika jest pusta. Możliwe, że użytkownik niczego nie udostępnia lub robi to prywatnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de arquivos compartilhados do usuário está vazia. Ou o usuário não está compartilhando nada, ou está compartilhando arquivos de forma privada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de ficheiros partilhados do utilizador está vazia. Ou o utilizador não partilha nada, ou partilha ficheiros de forma privada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список общих файлов пользователя пуст. Пользователь не хочет ничем делиться, либо делится файлами персонально."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பகிரப்பட்ட கோப்புகளின் பயனரின் பட்டியல் காலியாக உள்ளது. பயனர் எதையும் பகிரவில்லை, அல்லது அவர்கள் கோப்புகளை தனிப்பட்ட முறையில் பகிர்கிறார்கள்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcının paylaşılan dosyalar listesi boş. Ya kullanıcı hiçbir şey paylaşmıyor ya da dosyaları özel olarak paylaşıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список спільних файлів користувача порожній. Або користувач нічим не ділиться, або він ділиться файлами приватно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户的共享文件列表为空。用户没有共享任何内容，或者共享文件均为私密。"
          }
        }
      }
    },
