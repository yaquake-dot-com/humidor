    "Wishlist items are auto-searched at regular intervals, for discovering uncommon files.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els elements de la llista de desitjos se cerquen automàticament a intervals regulars per a descobrir fitxers poc comuns."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky seznamu přání jsou automaticky hledány v pravidelných intervalech, aby byly nalezeny neobyčejné soubory."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wunschlisten-Artikel werden regelmäßig automatisch gesucht, um seltene Dateien zu entdecken."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos de la lista de deseos se buscan automáticamente a intervalos regulares para descubrir archivos poco comunes."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos de la lista de deseos se buscan automáticamente a intervalos regulares para descubrir archivos poco comunes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sooviloendi üksusi otsitakse regulaarselt korrapäraste ajavahemike järel, et leida haruldasi faile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments de la liste de souhaits font l'objet d'une recherche automatique à intervalles réguliers, afin de découvrir des fichiers peu courants."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kívánságlista elemei között rendszeres időközönként, automatikus keresést végez, a ritka fájlok felfedezéséhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi della lista dei desideri vengono cercati automaticamente periodicamente, per scoprire file non comuni."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēlmju saraksta vienumi tiek automātiski meklēti regulāros intervālos, lai atrastu reti sastopamus failus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlanglijst-items worden automatisch met regelmatige tussenpozen gezocht om ongebruikelijke bestanden te ontdekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozycje listy życzeń są automatycznie przeszukiwane w regularnych odstępach czasu, w celu wykrycia niecodziennych plików."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens da lista de desejos são pesquisados automaticamente em intervalos regulares, para descobrir arquivos incomuns."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens da lista de desejos são pesquisados automaticamente em intervalos regulares, para descobrir ficheiros incomuns."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список желаемого автоматически просматривается через регулярные промежутки времени для обнаружения файлов."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அசாதாரண கோப்புகளைக் கண்டுபிடிப்பதற்காக, விருப்பப்பட்டியல் உருப்படிகள் தானாகவே தேடப்படுகின்றன."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilek listesi ögeleri, olağan dışı dosyaları keşfetmek için düzenli aralıklarla otomatik olarak aranır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Елементи списку бажань автоматично шукаються через регулярні проміжки часу для виявлення файлів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心愿单条目会定期自动搜索，以发现稀有文件。"
          }
        }
      }
    },
