    "Users' attempts to download your shared files are queued and managed here": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els intents dels usuaris de descarregar els teus fitxers compartits es posen en cua i es gestionen aquí"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokusy uživatelů o stažení vašich sdílených souborů je možné vidět a spravovat zde"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Downloadversuche deiner freigegebenen Dateien werden hier in die Warteschlange eingereiht und verwaltet"
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intentos de los usuarios de descargar sus archivos compartidos se ponen en cola y se gestionan aquí"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intentos de otros usuarios de descargar tus archivos compartidos se ponen en cola y se gestionan aquí"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasutajate katsed sinu jagatud faile alla laadida pannakse järjekorda ja neid hallatakse siin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tentatives des utilisateurs pour télécharger vos fichiers partagés sont mises en file d'attente et gérées ici"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Ön által megosztott fájloknak a felhasználók általi letöltése itt kerül sorba állításra és kezelésre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tentativi degli utenti di scaricare i file condivisi vengono accodati e gestiti qui"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietotāju mēģinājumi lejupielādēt jūsu koplietotos failus tiek ierindoti un pārvaldīti šeit"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanvragen van gebruikers om jouw gedeelde bestanden te downloaden, worden hier in de wachtrij gezet en beheerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Próby pobierania przez użytkowników Twoich udostępnionych plików są tutaj kolejkowane i zarządzane"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tentativas dos usuários de baixar seus arquivos compartilhados são enfileiradas e gerenciadas aqui"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tentativas dos utilizadores de descarregar os seus ficheiros partilhados são enfileiradas e gerenciadas aqui"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попытки пользователей загрузить ваши общие файлы ставятся в очередь и управляются здесь"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பகிரப்பட்ட கோப்புகளைப் பதிவிறக்குவதற்கான பயனர்களின் முயற்சிகள் இங்கே வரிசைப்படுத்தப்பட்டு நிர்வகிக்கப்படுகின்றன"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcıların paylaşılan dosyalarınızı indirme girişimleri burada kuyruğa alınır ve yönetilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спроби користувачів завантажити ваші спільні файли стоять у черзі й керуються тут"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户尝试下载您的共享文件在此处排队和管理"
          }
        }
      }
    },
    "Values must be entered as numeric digits only. The unit is always Kb/s (Kilobits per second).": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els valors només s'han d'introduir com a dígits numèrics. La unitat és sempre Kb/s (kilobits per segon)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodnoty musí být zadány pouze jako číslice. Jednotkou je vždy Kb/s (kilobit za sekundu)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werte müssen ausschließlich als numerische Ziffern eingegeben werden. Die Einheit ist immer Kb/s (Kilobit pro Sekunde)."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores deben introducirse solo como dígitos numéricos. La unidad es siempre Kb/s (Kilobits por segundo)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Väärtused tuleb sisestada ainult numbritena. Ühik on alati Kb/s (kilobitti sekundis)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs ne doivent contenir que des chiffres. L'unité est toujours Kb/s (Kilobits par seconde)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értékeket számjegykkel kell megadni. A mértékegység mindig Kb/s (Kilóbit/s)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori devono essere inseriti solo come cifre numeriche. L'unità è sempre Kb/s (Kilobit al secondo)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vērtības jāievada tikai kā ciparu zīmes. Vienība vienmēr ir Kb/s (kilobiti sekundē)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarden mogen alleen als numerieke cijfers worden ingevoerd. De eenheid is altijd Kb/s (Kilobits per seconde)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartości należy wprowadzać wyłącznie jako cyfry. Jednostką jest zawsze Kb/s (kilobity na sekundę)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores devem ser inseridos apenas como dígitos numéricos. A unidade é sempre Kb/s (Kilobits por segundo)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores devem ser inseridos apenas como dígitos numéricos. A unidade é sempre Kb/s (Kilobits por segundo)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения должны быть введены только в виде цифр. Единицей всегда является кбит/с (килобиты в секунду)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மதிப்புகள் எண் இலக்கங்களாக மட்டுமே உள்ளிடப்பட வேண்டும். அலகு எப்போதும் kb/s (வினாடிக்கு கிலோபிட்)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değerler yalnızca sayısal basamak olarak girilmelidir. Birim her zaman Kb/s'dir (Kilobit/saniye)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "值只能以数字形式输入。单位始终为 Kb/s（千比特每秒）。"
          }
        }
      }
    },
