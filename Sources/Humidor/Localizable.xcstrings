    "Log in to an existing Soulseek account or create a new one. Usernames are case-sensitive and unique.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sessió en un compte de Soulseek existent o crea un de nou. Els noms d'usuari distingeixen entre majúscules i minúscules i són únics."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se k existujícímu účtu Soulseek nebo si vytvořte nový. Uživatelská jména jsou citlivá na velikost písmen a jsou jedinečná."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei einem bestehenden Soulseek-Konto an oder erstelle ein neues. Benutzernamen sind groß- und kleinschreibungsempfindlich und einzigartig."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sesión en una cuenta existente de Soulseek o cree una nueva. Los nombres de usuario distinguen entre mayúsculas y minúsculas y son únicos."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en una cuenta existente de Soulseek o crea una nueva. Los nombres de usuario distinguen entre mayúsculas y minúsculas y son únicos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Logi olemasolevale Soulseeki kontole sisse või loo uus. Kasutajanimed on tõusutundlikud ja ainulaadsed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à un compte Soulseek existant ou créez-en un nouveau. Les noms d'utilisateur sont sensibles à la casse et uniques."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezzen be egy meglévő Soulseek fiókba, vagy hozzon létre egy újat. A felhasználónevek kis- és nagybetű érzékenyek és egyediek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a un account Soulseek esistente o creane uno nuovo. I nomi utente fanno distinzione tra maiuscole e minuscole e sono univoci."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieteicieties esošā Soulseek kontā vai izveidojiet jaunu kontu. Lietotājvārdi ir reģistrjutīgi un unikāli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in op een bestaand Soulseek-account of maak een nieuw account aan. Gebruikersnamen zijn hoofdlettergevoelig en uniek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się do istniejącego konta Soulseek lub utwórz nowe. W nazwach użytkowników rozróżniana jest wielkość liter i są one unikatowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login em uma conta Soulseek existente ou crie uma nova. Os nomes de usuário diferenciam maiúsculas de minúsculas e são exclusivos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login numa conta Soulseek existente ou crie uma nova. Os nomes de utilizador diferenciam maiúsculas de minúsculas e são exclusivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в существующую учетную запись Soulseek или создайте новую. Имена пользователей уникальны и чувствительны к регистру."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்கனவே உள்ள ஆன்மாதேடு கணக்கில் உள்நுழைக அல்லது புதிய ஒன்றை உருவாக்கவும். பயனர்பெயர்கள் வழக்கு உணர்திறன் மற்றும் தனித்துவமானவை."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut bir Soulseek hesabıyla oturum açın veya yeni bir tane oluşturun. Kullanıcı adları büyük/küçük harfe duyarlıdır ve benzersizdir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть до наявного облікового запису Soulseek або створіть новий. Імена користувачів чутливі до регістру та унікальні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录现有的 Soulseek 帐户或创建一个新帐户。用户名区分大小写且唯一。"
          }
        }
      }
    },
