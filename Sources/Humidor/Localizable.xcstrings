    "Do you really want to permanently delete all logged messages for this room?": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vols suprimir permanentment tots els missatges registrats per a aquesta sala?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu chcete trvale smazat všechny protokolované zprávy pro tuto místnost?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du wirklich alle protokollierten Nachrichten für diesen Raum dauerhaft löschen?"
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Realmente quieres borrar permanentemente todos los mensajes registrados para esta sala?"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¿De verdad quieres borrar permanentemente todos los mensajes registrados en esta sala?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas soovid tõesti kõik selle ruumi logitud sõnumid jäädavalt kustutada?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer définitivement tous les messages enregistrés de ce salon ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Véglegesen törölni akarja a szoba összes naplózott üzenetét?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler eliminare definitivamente tutti i messaggi registrati per questo canale?"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai tiešām vēlaties neatgriezeniski dzēst visas žurnālā reģistrētās ziņas šai istabai?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wil je echt alle gelogde berichten voor deze kamer permanent verwijderen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz trwale usunąć wszystkie zarejestrowane wiadomości dla tego pokoju?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você realmente deseja excluir permanentemente todas as mensagens registradas para esta sala?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Realmente deseja apagar permanentemente todas as mensagens registadas para esta sala?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы действительно хотите навсегда удалить все сообщения из этой комнаты?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த அறைக்கு உள்நுழைந்த அனைத்து செய்திகளையும் நிரந்தரமாக நீக்க விரும்புகிறீர்களா?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oda için kayıtlı tüm mesajları kalıcı olarak silmek istediğinizden emin misiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви дійсно хочете назавжди видалити всі повідомлення для цієї кімнати?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您确定要永久删除此房间的所有消息记录吗？"
          }
        }
      }
    },
