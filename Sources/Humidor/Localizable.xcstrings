        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略用户"
          }
        }
      }
    },
    "Ignore chat messages and search results from users, based on username or IP address.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorar els missatges de xat i els resultats de la cerca dels usuaris, segons el nom d'usuari o l'adreça IP."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorovat zprávy chatu a výsledky vyhledávání od uživatelů na základě uživatelského jména nebo IP adresy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoriere Chat-Nachrichten und Suchergebnisse von Benutzern, basierend auf Benutzername oder IP-Adresse."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorar mensajes de charla y resultados de búsqueda de usuarios, basado en nombre de usuario o dirección IP."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorar los mensajes de chat y los resultados de búsqueda de los usuarios basándose en el nombre de usuario o en la dirección IP."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eira kasutajate vestlussõnumeid ja otsingutulemusi kasutajanime või IP aadressi alusel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorer les discussions et les résultats de recherche des utilisateurs, en fonction du nom d'utilisateur ou de l'adresse IP."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Figyelmen kívül hagyja a felhasználók csevegés üzeneteit és keresési eredményeit, a felhasználónév vagy az IP-cím alapján."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignora messaggi di chat e risultati di ricerca degli utenti, in base al nome utente o all'indirizzo IP."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorēt lietotāju tērzēšanas ziņas un meklēšanas rezultātus, pamatojoties uz lietotājvārdu vai IP adresi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatberichten en zoekresultaten van gebruikers negeren, op basis van gebruikersnaam of IP-adres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoruj wiadomości czatu i wyniki wyszukiwania od użytkowników na podstawie nazwy użytkownika lub adresu IP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore mensagens de bate-papo e resultados de pesquisa de usuários, com base no nome de usuário ou endereço IP."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore mensagens de bate-papo e resultados de pesquisa de utilizadores, com base no nome de utilizador ou endereço IP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игнорировать сообщения и результаты поиска, основываясь на имени пользователя или IP-адресе."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயனர்பெயர் அல்லது ஐபி முகவரியின் அடிப்படையில் பயனர்களிடமிருந்து அரட்டை செய்திகள் மற்றும் தேடல் முடிவுகளை புறக்கணிக்கவும்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı adı veya IP adresine göre kullanıcılardan gelen sohbet mesajlarını ve arama sonuçlarını yok say."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ігнорувати повідомлення чату та результати пошуку від користувачів на основі імені користувача чи IP-адреси."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据用户名或IP地址，忽略来自用户的聊天消息和搜索结果。"
          }
        }
      }
    },
