        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு பயனரின் பயனர் விளக்கம், செய்தி மற்றும் தனிப்பட்ட படத்தைக் காண பெயரை உள்ளிடவும்"
          }
