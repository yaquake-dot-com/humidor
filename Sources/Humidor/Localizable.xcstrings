    "Instances of $ are replaced by the URL. Default system applications are used in cases where a protocol has not been configured.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les instàncies de $ es substitueixen per l'URL. Les aplicacions del sistema predeterminades s'utilitzen en els casos en què no s'ha configurat un protocol."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výskyty $ jsou nahrazeny adresou URL. Výchozí systémové aplikace jsou použity v případech, kde nebyl nastaven protokol."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Instanzen von $ werden durch die URL ersetzt. Standard-Systemanwendungen werden verwendet, falls kein Protokoll konfiguriert wurde."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apariciones de $ son sustituidas por la URL. Se utilizan las aplicaciones por defecto del sistema en los casos en que no se haya configurado un protocolo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apariciones de $ son sustituidas por la URL. Se utilizan las aplicaciones por defecto del sistema en los casos en que no se haya configurado un protocolo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "$ instatntsid asendatakse URL-iga. Süsteemi vaikerakendusi kasutatakse juhtudel, kui protokoll pole seadistatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les occurrences de $ seront remplacées par son adresse. L'application par défaut du système sera utilisée si aucun protocole n'a pas été configuré."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A $ jel helyére az URL kerül. Az alapértelmezett rendszeralkalmazások olyan esetekben használatosak, amikor egy protokoll nincs konfigurálva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le occorrenze di $ saranno sostituite dall'URL. Verranno aperte le applicazioni di sistema predefinite nei casi in cui non è stato configurato un protocollo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "$ gadījumi tiek aizstāti ar URL. Noklusējuma sistēmas lietotnes tiek izmantotas gadījumos, kad protokols nav konfigurēts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instanties van $ worden vervangen door de URL. Standaard systeemapplicaties worden gebruikt in gevallen waar een protocol niet is geconfigureerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystąpienia $ są zastępowane przez adres URL. Domyślne aplikacje systemowe są używane w przypadkach, gdy protokół nie został skonfigurowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As instâncias de $ são substituídas pela URL. Os aplicativos padrão do sistema são usados nos casos em que um protocolo não foi configurado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As instâncias de $ são substituídas pela URL. As aplicações padrão do sistema são usadas nos casos em que um protocolo não foi configurado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Символ $ заменяется URL-адресом. По умолчанию будут использованы системные приложения, если протокол не был сконфигурирован."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Of இன் நிகழ்வுகள் முகவரி ஆல் மாற்றப்படுகின்றன. ஒரு நெறிமுறை கட்டமைக்கப்படாத சந்தர்ப்பங்களில் இயல்புநிலை கணினி பயன்பாடுகள் பயன்படுத்தப்படுகின்றன."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "$ karakterleri URL ile değiştirilecektir. Bir protokolün yapılandırılmadığı durumlarda öntanımlı sistem uygulamaları kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Примірники $ замінюються URL-адресою. Системні програми за замовчуванням використовуються в тих випадках, коли протокол не налаштовано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "$ 的实例被 URL 替换。在未配置协议的情况下使用默认系统应用程序。"
          }
        }
      }
    },
