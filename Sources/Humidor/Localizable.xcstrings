            "state": "translated",
            "value": "Nicotine+ kullanmaya hazırsınız!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви готові до використання Nicotine+!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicotine+ 已经可以使用!"
          }
        }
      }
    },
    "You are still uploading files. Do you really want to exit?": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara estàs compartint fitxers. Realment vols sortir?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stále nahráváte soubory. Opravdu chcete skončit?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lädst immer noch Dateien hoch. Willst du wirklich beenden?"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía tienes ficheros subiendo. ¿De verdad quieres salir?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadid endiselt faile üles. Kas soovid tõesti väljuda?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous téléchargez toujours des fichiers. Voulez vous vraiment quitter ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még mindig tölt fel fájlokat. Valóban ki akar lépni?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai ancora caricando file. Sei sicuro di voler uscire?"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūs joprojām augšupielādējat failus. Vai tiešām vēlaties iziet?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent nog aan het uploaden. Wil je echt afsluiten?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wciąż wysyłasz pliki. Czy na pewno chcesz wyjść?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda está enviando arquivos. Você realmente quer sair?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda está a carregar ficheiros. Quer mesmo sair?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас есть активные раздачи. Вы действительно хотите выйти из Nicotine+?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் இன்னும் கோப்புகளை பதிவேற்றுகிறீர்கள். நீங்கள் உண்மையில் வெளியேற விரும்புகிறீர்களா?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hala dosya yüklüyorsunuz. Gerçekten çıkmak istiyor musunuz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви все ще завантажуєте файли. Ви дійсно хочете вийти?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您正在上传文件。真的要退出吗？"
          }
        }
      }
    },
