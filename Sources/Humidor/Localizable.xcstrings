    "User %@ already exists, and the password you entered is invalid. Please choose another username if this is your first time logging in.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'usuari %@ ja existeix i la contrasenya que has introduït no és vàlida. Si us plau, tria un altre nom d'usuari si és la primera vegada que inicies sessió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživatel %@ již existuje a zadané heslo je neplatné. Pokud se přihlašujete poprvé, zvolte jiné uživatelské jméno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzer %@ existiert bereits und das eingegebene Passwort ist ungültig. Bitte wähle einen anderen Benutzernamen, wenn du dich zum ersten Mal anmeldest."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "El usuario %@ ya existe y la contraseña que ha introducido no es válida. Por favor, elija otro nombre de usuario si es la primera vez que se conecta."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El usuario %@ ya existe y la contraseña que has introducido no es válida. Por favor, elige otro nombre de usuario si es la primera vez que te conectas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasutaja %@ on juba olemas ja sisestatud parool on kehtetu. Kui logid sisse esimest korda, vali mõni muu kasutajanimi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'utilisateur %@ existe déjà, et le mot de passe que vous avez entré n'est pas valide. Choisissez un autre nom d'utilisateur si c'est votre premier essai."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ felhasználó már létezik, és a megadott jelszó érvénytelen. Kérem válasszon másik felhasználónevet ha először jelentkezik be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'utente %@ esiste già e la password inserita non è valida. Scegli un altro nome utente se è la prima volta che accedi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietotājs %@ jau pastāv, un ievadītā parole nav derīga. Lūdzu, izvēlieties citu lietotājvārdu, ja pieslēdzaties pirmo reizi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruiker %@ bestaat al,en het wachtwoord dat je hebt ingevoerd is ongeldig. Kies een andere gebruikersnaam, als dit de eerste keer is dat je inlogt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użytkownik %@ już istnieje, a wprowadzone hasło jest nieprawidłowe. Proszę wybrać inną nazwę użytkownika, jeśli logujesz się po raz pierwszy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O usuário %@ já existe e a senha que você digitou é inválida. Por favor, escolha outro nome de usuário se este for seu primeiro login."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuário %@ já existe, e a senha inserida é inválida. Por favor escolha outra nome de usuário se essa for a sua primeira vez acessando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользователь %@ уже существует, но введенный вами пароль неверен. Если вы входите в первый раз, пожалуйста, выберите другое имя пользователя."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயனர் %@ ஏற்கனவே உள்ளன, நீங்கள் உள்ளிட்ட கடவுச்சொல் தவறானது. இது உங்கள் முதல் முறையாக உள்நுழைந்தால் மற்றொரு பயனர்பெயரைத் தேர்வுசெய்க."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kullanıcısı zaten var ve girdiğiniz parola geçersiz. İlk kez oturum açıyorsanız lütfen başka bir kullanıcı adı seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Користувач %@ вже існує, а введений пароль недійсний. Будь ласка, виберіть інше ім’я користувача, якщо це ваш перший вхід."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户%@已经存在，您输入的密码无效。如果这是您第一次登录，请更换用户名。"
          }
        }
      }
    },
