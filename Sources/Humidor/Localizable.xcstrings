        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidání uživatelů do seznamu kamarádů pro sdílení konkrétních složek s nimi a přijímání oznámení, když jsou online"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Nutzer als Freunde hinzu, um bestimmte Ordner mit ihnen zu teilen und Benachrichtigungen zu erhalten, wenn sie online sind"
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade usuarios a tu lista de amigos para compartir con ellos carpetas específicas y recibir notificaciones cuando estén conectados"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade usuarios a tu lista de amigos para compartir con ellos carpetas específicas y recibir notificaciones cuando estén conectados"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa kasutajad sõpradeks, et jagada nendega kindlaid kaustu ja saa märguandeid, kui nad on võrgus"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des utilisateurs à votre liste d'amis pour partager des dossiers spécifiques avec eux et recevoir des notifications lorsqu'ils sont en ligne"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon hozzá felhasználókat barátokként, hogy mappákat oszthasson meg velük, és értesítést kapjon ha be vannak jelentkezve"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi utenti come amici per condividere cartelle specifiche con loro e ricevere notifiche quando sono online"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievienojiet lietotājus kā draugus, lai koplietotu ar viņiem noteiktas mapes un saņemtu paziņojumus, kad viņi ir tiešsaistē"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg gebruikers toe als vrienden om specifieke mappen met hen te delen en ontvang meldingen wanneer ze online zijn"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj użytkowników do swojej listy znajomych, aby udostępniać im określone foldery i otrzymywać powiadomienia, gdy są dostępni"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione usuários como amigos para compartilhar pastas específicas com eles e receber notificações quando estiverem online"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione utilizadores como amigos para partilhar pastas específicas com eles e receber notificações quando estiverem online"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте пользователей в список друзей, чтобы делиться с ними общими каталогами и получать уведомления, когда они в сети"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறிப்பிட்ட கோப்புறைகளை அவர்களுடன் பகிர்ந்து கொள்ள பயனர்களை நண்பர்களாகச் சேர்க்கவும், ஆன்லைனில் இருக்கும்போது அறிவிப்புகளைப் பெறவும்"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirli klasörleri onlarla paylaşmak ve çevrim içi olduklarında bildirim almak için kullanıcıları arkadaş olarak ekleyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте користувачів як друзів, щоб ділитися з ними певними каталогами та отримувати сповіщення, коли вони в мережі"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加用户为好友，与他们分享特定的文件夹，并在他们在线时收到通知"
          }
        }
      }
    },
