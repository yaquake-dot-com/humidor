    "Show only those results from users which have at least one upload slot free, i.e. files that are available immediately.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra només resultats d'usuaris que tinguin almenys un lloc de pujada disponible, és a dir, fitxers que estiguin disponibles immediatament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit výsledky pouze od uživatelů, kteří mají volný alespoň jeden slot pro nahrávání, tedy zobrazí se soubory dostupné ihned ke stažení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige nur Ergebnisse von Nutzern, die mindestens einen Upload-Slot frei haben, also Dateien, die sofort verfügbar sind."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar sólo los resultados de los usuarios que tienen al menos una ranura de carga libre, es decir, los archivos que están disponibles inmediatamente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva tulemused ainult nendelt kasutajatelt, kellel on vähemalt üks üleslaadimispesa vaba, st failid, mis on kohe saadaval."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'afficher que les résultats des utilisateurs qui ont au moins un créneau de téléchargement libre, c'est-à-dire des fichiers disponibles immédiatement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak azokat az eredményeket jelenítse meg a felhasználóktól, ahol legalább egy feltöltési szál szabad, azaz olyan fájlokat amelyek azonnal elérhetőek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra solo i risultati dagli utenti che hanno almeno uno slot di upload libero, ovvero file che sono disponibili immediatamente."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rādīt tikai to lietotāju rezultātus, kuriem ir vismaz viens brīvs augšupielādes slots, t. i., failus, kas ir pieejami nekavējoties."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen resultaten van gebruikers weergeven die ten minste één uploadslot vrij hebben, oftewel bestanden die direct beschikbaar zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż tylko te wyniki od użytkowników, którzy mają przynajmniej jeden wolny slot. Ten filtr jest stosowany natychmiast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar apenas os resultados de usuários que têm pelo menos um slot de upload livre, ou seja, arquivos que estão disponíveis imediatamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar apenas os resultados de utilizadores que têm pelo menos um slot de upload livre, ou seja, ficheiros que estão disponíveis imediatamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать только те результаты от пользователей, у которых свободен хотя бы один слот раздачи, т.е. файлы, которые доступны немедленно."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறைந்தது ஒரு பதிவேற்ற ச்லாட் இலவசம் கொண்ட பயனர்களிடமிருந்து அந்த முடிவுகளை மட்டுமே காட்டுங்கள், அதாவது உடனடியாக கிடைக்கும் கோப்புகள்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca en az bir yükleme yuvası boş olan kullanıcılardan gelen sonuçları, yani hemen kullanılabilir olan dosyaları göster."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示至少有一个可用上传槽位的用户的结果，即立即可用的文件。"
          }
        }
      }
    },
    "Show privately shared files in search results": {
