        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆன்மாதேடு பிணைப்பில் பிற பயனர்களால் பகிரப்பட்ட கோப்புகளைத் தேட ஒரு தேடல் காலத்தை உள்ளிடவும்"
