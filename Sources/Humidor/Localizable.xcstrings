            "value": "Vzor vyhledávání: se slovem = slovo, beze slova = -slovo, částečné slovo = *lovo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchmuster: mit einem Wort = Begriff, ohne ein Wort = -Begriff, Teilwort = *iff"
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrones de búsqueda: con una palabra = término, sin palabra = -término, palabra parcial = *érmino"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrones de búsqueda: con una palabra = término, sin palabra = -término, palabra parcial = *érmino"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsingumustrid: sõnaga = termin, ilma sõnata = -termin, osaline sõna = *erm"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèles de recherche : avec un mot = terme, sans mot = -terme, mot partiel = *erme"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Keresési minták: tartalmaz egy szót = kifejezés; ne tartalmazza a szót = -kifejezés; tartalmaz egy szórészt = *ifejezés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelli di ricerca: con una parola = term, senza una parola = -term, parola parziale = *erm"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Meklēšanas modeļi: ar vārdu = vienums, bez vārda = -vienums, daļējs vārds = *nums"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoekpatronen: met een woord = term, zonder een woord = -term, gedeeltelijk woord = *erm"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wzory wyszukiwania: z wyrazem = wyrażenie, bez wyrazu = -wyrażenie, część wyrazu = *erm"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Padrões de pesquisa: com uma palavra = termo, sem uma palavra = -termo, palavra parcial = *ermo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Padrões de pesquisa: com uma palavra = termo, sem uma palavra = -termo, palavra parcial = *ermo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны поиска: со словом = слово, исключить слово = -слово, частичное слово = *лово"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேடல் வடிவங்கள்: ஒரு சொல் = காலத்துடன், ஒரு சொல் இல்லாமல் = -term, பகுதி சொல் = *erm"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama kalıpları: bir sözcük ile = terim, bir sözcük olmadan = -terim, kısmi sözcük = *erim"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблони пошуку: зі словом = слово, без слова = -слово, часткове слово = *ово"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索匹配模式：输入包含的文字 = 搜索内容，排除包含的文字 = -搜索内容，模糊匹配 = *内容"
          }
        }
      }
    },
    "Search result filters are used to refine which search results are displayed.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els filtres de resultats de cerca s'utilitzen per a definir quins resultats de cerca es mostren."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtry výsledků hledání určují, které výsledky vyhledávání se mají zobrazit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchergebnisfilter werden verwendet, um zu verfeinern, welche Suchergebnisse angezeigt werden."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Los filtros de resultados de búsqueda se utilizan para refinar los resultados de búsqueda mostrados."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los filtros de resultados de búsqueda se utilizan para refinar los resultados de búsqueda mostrados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsingutulemuste filtreid kasutatakse kuvatavate otsingutulemuste täpsustamiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les filtres de résultats de recherche sont utilisés pour affiner les résultats de recherche affichés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A keresési eredmények szűrői a megjelenítésre kerülő keresési eredmények finomítására szolgálnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I filtri dei risultati di ricerca vengono utilizzati per perfezionare i risultati di ricerca visualizzati."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Meklēšanas rezultātu filtri tiek izmantoti, lai precizētu, kuri meklēšanas rezultāti tiek rādīti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoekresultaatfilters worden gebruikt om te verfijnen welke zoekresultaten worden weergegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtry wyników wyszukiwania służą do precyzyjnego określania wyświetlanych wyników wyszukiwania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os filtros de resultados de pesquisa são usados para refinar quais resultados de pesquisa são exibidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os filtros de resultados de pesquisa são usados para refinar quais resultados de pesquisa são exibidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используются для уточнения отображаемых результатов."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேடல் முடிவுகள் எந்த தேடல் முடிவுகள் காண்பிக்கப்படுகின்றன என்பதைச் சுத்திகரிக்க தேடல் முடிவு வடிப்பான்கள் பயன்படுத்தப்படுகின்றன."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama sonucu filtreleri, hangi arama sonuçlarının görüntüleneceğini belirlemek için kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фільтри результатів пошуку використовуються, щоб уточнити, які результати пошуку відображаються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索结果筛选器用于控制哪些搜索结果显示或不显示。"
          }
        }
      }
    },
