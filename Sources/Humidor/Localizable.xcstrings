    "Enter a text pattern and what to replace it with:": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix un patró de text i allò pel que ha de ser reemplaçat:"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte vzor textu a čím má být nahrazen:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ein Textmuster und das Ersetzungsmuster ein:"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un patrón de texto y su reemplazo:"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisesta tekstimuster ja millega see asendada:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez le modèle de texte et son remplacement :"
          }
        },
        "hu": {
